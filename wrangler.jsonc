{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusconnect-development",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campusconnect-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "worker/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOW_FICTIONAL_EVENTS": "true",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787",
    "INTEREST_WEIGHT": "10",
    "SCHEDULE_WEIGHT": "5",
    "REVERIFY_AFTER_DAYS": "7",
  },
  "env": {
    "production": {
      "name": "campusconnect-production",
      "workers_dev": false,
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "campusconnect-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "worker/migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOW_FICTIONAL_EVENTS": "false",
        "ALLOWED_ORIGINS": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ADMIN_EMAILS": "",
        "INTEREST_WEIGHT": "10",
        "SCHEDULE_WEIGHT": "5",
        "REVERIFY_AFTER_DAYS": "7",
      },
    },
  },
}
